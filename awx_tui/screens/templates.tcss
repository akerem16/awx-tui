/* Templates Screen */

Screen {
    background: $surface;
}

/* Top Panel - Status bar with rotating title */
.top-panel {
    dock: top;
    height: 3;
    border: solid $primary;
    padding: 0 1;
}

.top-panel-layout {
    height: 100%;
}

.top-title {
    width: auto;
    height: 100%;
    padding: 0 1;
    content-align: left middle;
}

.top-jobs {
    width: 1fr;
    height: 100%;
    content-align: center middle;
    padding: 0 2;
}

.top-refresh {
    width: auto;
    height: 100%;
    content-align: right middle;
    padding: 0 1;
}

/* Filter input */
#filter-input {
    margin: 0;
    margin-left: 1;
    margin-right: 1;
}

/* Main container */
#templates-container {
    width: 100%;
    height: 1fr;
    border: solid $primary;
    margin: 0 1 1 1;
}

/* Table header */
.table-header {
    dock: top;
    height: 1;
    width: 100%;
    padding: 0 1;
    background: $boost;
    color: $text-muted;
}

/* Templates table */
#templates-table {
    width: 100%;
    height: 100%;
}
