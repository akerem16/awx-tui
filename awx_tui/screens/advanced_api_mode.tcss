/* Advanced API Mode Screen Styles */

AdvancedAPIModeScreen {
    background: $surface;
}

/* Top controls container */
#controls-container {
    dock: top;
    height: auto;
    background: $boost;
    padding: 1;
    border-bottom: solid $primary;
}

#instance-info {
    dock: top;
    width: 100%;
    height: 1;
    content-align: left middle;
    margin-bottom: 1;
    text-style: bold;
    color: $accent;
}

/* Request line: Method selector + Endpoint input */
#request-line {
    width: 100%;
    height: 3;
    margin-bottom: 1;
}

#method-select {
    width: 15;
    margin-right: 1;
}

#endpoint-input {
    width: 1fr;
}

/* Action line: Buttons + Checkbox */
#action-line {
    width: 100%;
    height: 3;
    align: left middle;
}

#send-button {
    margin-right: 1;
}

#clear-button {
    margin-right: 2;
}

#validate-checkbox {
    height: 1;
    padding: 0 1;
}

/* Tabbed content area */
#content-tabs {
    height: 1fr;
}

/* Request/Response pane (split 50/50) */
#request-response-pane {
    width: 100%;
    height: 1fr;
}

#request-body-container {
    width: 50%;
    height: 100%;
    border-right: solid $primary;
}

#response-container {
    width: 50%;
    height: 100%;
}

/* Headers pane (split 50/50) */
#headers-pane {
    width: 100%;
    height: 1fr;
}

#request-headers-container {
    width: 50%;
    height: 100%;
    border-right: solid $primary;
}

#response-headers-container {
    width: 50%;
    height: 100%;
}

/* Pane headers */
.pane-header {
    dock: top;
    width: 100%;
    height: 1;
    background: $panel;
    content-align: center middle;
    text-style: bold;
    color: $text;
}

/* TextArea widgets */
#request-body {
    height: 1fr;
    border: none;
}

#response-body {
    height: 1fr;
    border: none;
}

#request-headers {
    height: 1fr;
    border: none;
}

#response-headers {
    height: 1fr;
    border: none;
}
