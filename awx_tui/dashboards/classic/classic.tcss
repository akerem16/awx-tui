/* Dashboard - Per DASHBOARD.md */

Screen {
    background: $surface;
}

/* Top Panel - Status bar with rotating title */
.top-panel {
    dock: top;
    height: 3;
    border: solid $primary;
    padding: 0 1;
}

.top-panel-layout {
    height: 100%;
}

.top-title {
    width: auto;
    height: 100%;
    padding: 0 1;
    content-align: left middle;
}

.top-jobs {
    width: 1fr;
    height: 100%;
    content-align: center middle;
    padding: 0 2;
}

.top-refresh {
    width: auto;
    height: 100%;
    content-align: right middle;
    padding: 0 1;
}

.classic-dashboard {
    width: 100%;
    height: 100%;
}

/* Row 1: INSTANCES | INSTANCE GROUPS */
.classic-dashboard #instances-row {
    width: 100%;
    height: 10;
    border: solid $primary;
    margin-bottom: 0;
}

.classic-dashboard #instances-panel,
.classic-dashboard #groups-panel {
    width: 1fr;
    padding: 0 1;
}

.classic-dashboard .section-header {
    color: $text-muted;
    margin-top: 0;
    margin-bottom: 0;
}

.classic-dashboard #instances-table,
.classic-dashboard #groups-table {
    height: 1fr;
    border: solid $secondary;
}

/* Row 2: SUCCESS (35%) | FAILED (35%) | STATS (30%) */
.classic-dashboard #graphs-row {
    width: 100%;
    height: 12;
    border: solid $primary;
    margin-bottom: 0;
}

.classic-dashboard .graph-box {
    width: 7fr;
    padding: 0 1;
}

.classic-dashboard .graph-header {
    color: $text-muted;
    margin-top: 0;
    margin-bottom: 0;
}

.classic-dashboard #success-table,
.classic-dashboard #failed-table {
    height: 1fr;
    border: solid $secondary;
}

.classic-dashboard .stats-box {
    width: 6fr;
    padding: 0 1;
}

/* Rows 3-4: Job Tables */
.classic-dashboard #running-jobs-panel {
    width: 100%;
    height: 7;
    border: solid $primary;
    margin-bottom: 0;
    padding: 0 1;
}

.classic-dashboard #recent-jobs-panel {
    width: 100%;
    height: 7;
    border: solid $primary;
    margin-bottom: 0;
    padding: 0 1;
}

.classic-dashboard .table-header {
    color: $text-muted;
    margin-top: 0;
    margin-bottom: 0;
}

.classic-dashboard #running-jobs-table,
.classic-dashboard #recent-jobs-table {
    height: 1fr;
}

DataTable {
    height: auto;
}
